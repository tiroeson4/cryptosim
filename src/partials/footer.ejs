<footer class="footer">
  <div class="footer__inner container">
    <p class="footer__copy">
      <small>© <%= year %> CryptoSim. <span data-i18n="footer.disclaimer"><%= t('footer.disclaimer') %></span></small>
    </p>
    <nav class="footer__nav" aria-label="<%= t('footer.navLabel') %>" data-i18n-aria-label="footer.navLabel">
      <ul class="footer__list">
        <li class="footer__item">
          <a class="footer__link" href="https://github.com/MarkovDmitriy/web-template-2025" rel="noopener" data-i18n="footer.template"><%= t('footer.template') %></a>
        </li>
        <li class="footer__item">
          <a class="footer__link" href="https://github.com/typicode/json-server" rel="noopener" data-i18n="footer.apiDocs"><%= t('footer.apiDocs') %></a>
        </li>
        <li class="footer__item">
          <a class="footer__link" href="#main" data-i18n="footer.backToTop"><%= t('footer.backToTop') %></a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
