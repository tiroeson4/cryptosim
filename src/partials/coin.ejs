<%# Coin icon (decorative). params: asset, large?, cls? %>
<% const isLarge = typeof large !== 'undefined' && large; const size = isLarge ? 36 : 28; %>
<span class="coin<%= isLarge ? ' coin--large' : '' %><%= typeof cls !== 'undefined' ? ' ' + cls : '' %>" aria-hidden="true">
  <img class="coin__img" src="/img/coins/<%= asset.toLowerCase() %>.svg" alt="" width="<%= size %>" height="<%= size %>" loading="lazy" decoding="async" />
</span>
