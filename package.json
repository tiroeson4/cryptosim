{
  "name": "cryptosim",
  "version": "0.2.0",
  "private": true,
  "description": "CryptoSim — crypto exchange simulator (web course labs, topic 8)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api \"vite\" \"npm run api\"",
    "api": "json-server --watch api/db.json --routes api/routes.json --port 5174",
    "build": "npm run lint && vite build",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "concurrently": "^8.2.2",
    "ejs": "^3.1.10",
    "eslint": "^9.8.0",
    "globals": "^15.9.0",
    "json-server": "^0.17.4",
    "sass": "^1.80.0",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dayjs": "^1.11.11"
  }
}
